#import "BucketArray"

#macro DEFAULT_PORT 7687

struct AppOptions {
    path_settings: StringBuilder;
    
    use_cli: bool;
    use_gui: bool;
    
    cli_input: StringBuilder;
}

enum SyncConnectionFlags {
    SYNCCON_NONE      = 0x0,
    SYNCCON_IS_SERVER = 0x1,
}
struct SyncConnection {
    name: StringBuilder;
    // status, flags
    
    ip: StringBuilder;
    port: u16;
    
    flags: SyncConnectionFlags;
    
    // TODO: Union
    server: Server;
    client: Client;
}

struct SyncUnit {
    name: StringBuilder;
    // status, flags
    
    root: StringBuilder;
    files: BucketArray<SyncFile>;
    // file monitor
    
    monitor: FileMonitor;
    
    fn find_file(path: char[]) -> SyncFile*, i32  {
        iter := files.create_iterator()
        while files.iterate(&iter) {
            it := iter.ptr
            if it.path == path {
                return it, iter.index
            }
        }
        return null, -1
    }
    
    fn cleanup() {
        name.cleanup()
        root.cleanup()
        files.cleanup()
    }
}
enum SyncFileFlags {
    SYNCFILE_IS_DIRECTORY=0x1,
}
struct SyncFile {
    timestamp: u64;
    flags: SyncFileFlags;
    path: StringBuilder; // relative to root
    remote_timestamp: u64;
    // hash
}

enum SyncErrorType {
    SYNCERR_NONE,
    SYNCERR_OCCUPIED_NAME,
    SYNCERR_NAME_NOT_FOUND,
    SYNCERR_CONNECTION_FAILED,
    SYNCERR_PATH_NOT_FOUND,
}
struct SyncSystem {
    loaded_from_path: StringBuilder; // where the user settings was loaded from, can be empty
 
    connections: Array<SyncConnection*>;
    units: Array<SyncUnit*>
    
    // returns false if name already exists
    fn add_unit(name: char[]) -> SyncErrorType {
        unit := find_unit(name)
        if unit
            return SYNCERR_OCCUPIED_NAME
        unit = cast<SyncUnit*>Allocate(sizeof SyncUnit)
        construct(unit)
        unit.name.append(name)
        unit.files.init(64)
        units.add(unit)
        return SYNCERR_NONE
    }
    // returns false if name already exists
    // or if old_name doens't exist
    fn rename_unit(old_name: char[], new_name: char[]) -> SyncErrorType {
        unit: SyncUnit*
        for units.sliced() {
            if it.name == new_name {
                return SYNCERR_OCCUPIED_NAME
            }
            if it.name == old_name {
                unit = it
            }
        }
        if !unit
            return SYNCERR_NAME_NOT_FOUND
        unit.name.clear()
        unit.name.append(new_name)
        return SYNCERR_NONE
    }
    fn add_connection(name: char[], ip: char[], port: u16) -> SyncErrorType {
        con := find_connection(name)
        if con
            return SYNCERR_OCCUPIED_NAME
        con = cast<SyncConnection*>Allocate(sizeof SyncConnection)
        construct(con)
        con.name.append(name)
        con.ip.append(ip)
        con.port = port
        connections.add(con)
        return SYNCERR_NONE
    }
    // returns false if name already exists
    // or if old_name doens't exist
    fn rename_connection(old_name: char[], new_name: char[]) -> SyncErrorType {
        con: SyncConnection*
        for connections.sliced() {
            if it.name == new_name {
                return SYNCERR_OCCUPIED_NAME
            }
            if it.name == old_name {
                con = it
            }
        }
        if !con
            return SYNCERR_NAME_NOT_FOUND
        con.name.clear()
        con.name.append(new_name)
        return SYNCERR_NONE
    }
    
    fn set_root(name: char[], path: char[]) -> SyncErrorType {
        unit := find_unit(name)
        if !unit
            return SYNCERR_NAME_NOT_FOUND
        
        yes := DirectoryExist(path)
        if !yes
            return SYNCERR_PATH_NOT_FOUND
        
        unit.monitor.cleanup()
        
        // TODO: Remove previous file monitor and threads
        // TODO: Make sure a connection isn't sending files and synchronizing, disable unit, abort?
        // TODO: Check if path is valid
        // TODO: Set file monitors
        unit.root.clear()
        unit.root.append(path)
        
        yes = unit.monitor.check(path, monitor_callback, MONITOR_DEFAULT, unit)
        if !yes {
            // TODO: Return monitor error? what does that mean though?
            return SYNCERR_PATH_NOT_FOUND
        }
        
        init_unit_root(unit)
        
        return SYNCERR_NONE
    }
    fn set_ip(name: char[], ip: char[]) -> SyncErrorType {
        con := find_connection(name)
        if !con
            return SYNCERR_NAME_NOT_FOUND
        
        con.ip.clear()
        con.ip.append(ip)
        
        return SYNCERR_NONE
    }
    fn set_connection_type(name: char[], is_server: bool) -> SyncErrorType {
        con := find_connection(name)
        if !con
            return SYNCERR_NAME_NOT_FOUND
            
        if is_server
            con.flags |= SYNCCON_IS_SERVER
        else
            con.flags &= ~SYNCCON_IS_SERVER
            
        return SYNCERR_NONE
    }
    fn start_connection(name: char[]) -> SyncErrorType {
        con := find_connection(name)
        if !con
            return SYNCERR_NAME_NOT_FOUND
            
        if con.flags & SYNCCON_IS_SERVER {
            con.server.set_callback(net_callback, con)
            err := con.server.start(con.port, NET_PROTO_MESSAGE)
            if err != NET_SUCCESS
                return SYNCERR_CONNECTION_FAILED
        } else {
            con.client.set_callback(net_callback, con)
            err := con.client.start(con.ip, con.port, NET_PROTO_MESSAGE)
            if err != NET_SUCCESS
                return SYNCERR_CONNECTION_FAILED
        }
            
        return SYNCERR_NONE
    }
    fn stop_connection(name: char[]) -> SyncErrorType {
        con := find_connection(name)
        if !con
            return SYNCERR_NAME_NOT_FOUND
            
        if con.flags & SYNCCON_IS_SERVER {
            con.server.close()
        } else {
            con.client.close()
        }
            
        return SYNCERR_NONE
    }
    
    fn find_connection(name: char[]) -> SyncConnection* {
        for connections.sliced() {
            if it.name == name {
                return it
            }
        }
        return null
    }
    fn find_unit(name: char[]) -> SyncUnit* {
        for units.sliced() {
            if it.name == name {
                return it
            }
        }
        return null
    }
}

fn init_unit_root(unit: SyncUnit*) {
    log("INIT UNIT ROOT")
    unit.files.clear() // TODO: Don't clear, we should merge files we find in the iterator with the ones we have.
    
    iter := DirectoryIteratorCreate(unit.root)
    defer DirectoryIteratorDestroy(iter)
    item: DirIteratorItem*;
    while DirectoryIteratorNext(iter, &item, true) {
        // i need to go through existing files and update them.
        // unit.
        log(" ", item.name," ", item.file_size)
        
        file, index := unit.files.add(null)
        if !file
            continue
        file.path.append(item.name)
        file.timestamp = item.last_write_time
        if item.is_directory
            file.flags |= SYNCFILE_IS_DIRECTORY
    }
}

fn monitor_callback(change: FileMonitorChange*, user_data: void*) {
    log(&change.type," ", change.path)
}

enum MessageType {
    INVALID_MESSAGE_TYPE,
    SYNC_UNITS_AND_FILES,
    REQUEST_FILE,
    STREAM_FILE,
}
struct MessageHeader {
    type: MessageType;
    version: i32;
}
fn net_callback(e: NetEvent, u: void*) {
    con := cast<SyncConnection*>u
    switch e.type {
        case EVENT_CONNECT:
            msg: u8[]
            stream: ByteStream
            
            header := cast<MessageHeader*>stream.write_late(sizeof MessageHeader)
            header.type = SYNC_UNITS_AND_FILES
            header.version = 1
            
            stream.write<i32>(sync_system.units.size())
            for unit: sync_system.units.sliced() {
                stream.write_string8(unit.name.sliced())
                stream.write<i32>(unit.files.getCount())
                iter := unit.files.create_iterator()
                while unit.files.iterate(&iter) {
                    file := iter.ptr
                    stream.write<u64>(file.timestamp)
                    stream.write(file.flags)
                    stream.write_string8(file.path.sliced())
                }
            }
            
            yes := stream.finalize(&msg)
            
            if con.flags & SYNCCON_IS_SERVER {
                con.server.send(msg, who = e.who)
            } else {
                con.client.send(msg)
            }
        case EVENT_RECEIVE:
            stream: ByteStream;
            defer stream.cleanup()
            stream.write(e.bytes.ptr, e.bytes.len)
            
            offset: i32;
            
            header: MessageHeader;
            stream.read(&offset, &header, sizeof MessageHeader)
            
            if header.version != 1 {
                // we don't support version
                return;
            }
            switch header.type {
                case SYNC_UNITS_AND_FILES:
                    log("Receive sync units")
                    unit_count: i32
                    stream.read(&offset, &unit_count)
                    for 0..unit_count {
                        unit_name: StringBuilder
                        defer unit_name.cleanup()
                        stream.read_string8(&offset, &unit_name)
                        file_count: i32
                        stream.read(&offset, &file_count)
                        log(" unit ", unit_name, " files ",file_count)
                        
                        local_unit := sync_system.find_unit(unit_name)
                        
                        for 0..file_count {
                            timestamp: u64
                            stream.read(&offset, &timestamp)
                            flags: SyncFileFlags
                            stream.read(&offset, &flags)
                            file_path: StringBuilder
                            defer file_path.cleanup()
                            stream.read_string8(&offset, &file_path)
                            
                            // compare files if valid unit
                            // if local_unit {
                            //     local_file := local_unit.find_file(file_path)
                            //     if local_file.remote_timestamp == timestamp {
                            //         // fine
                            //     } else if local_file.remote_timestamp < timestamp {
                            //         // remote has new version
                            //         // if my timestamp is newer than the received timestamp, i don't want to overwite my changes.
                            //         // if my timestamp is older than received timestamp, i don't want to either because i may have made changes it's just that remote made newer changes.
                            //         // if my timestamp is older than the remote timestamp then we should request new file
                            //         // the stored
                            //         if local_file.timestamp > 
                            //     } else {
                            //         log("Corruption? remote has an older timestamp than what we cached from last synchronization.")
                            //         // this may happen if remote switched the file by moving it out and moving in another with a different timestamp.
                            //         // what do we do in this case?
                            //     }
                            // }
                        }
                    }
                case:
                    // unknown type?
            }
            
        case:
    }
    // log(&e)
}

fn create_sync_system() -> SyncSystem* {
    ptr := cast<SyncSystem*>Allocate(sizeof SyncSystem)
    construct(ptr)
    return ptr
}
fn destroy_sync_system(system: SyncSystem*) {
    destruct(system)
    Free(system)
}

global sync_system: SyncSystem*;
fn start_sync_app(options: AppOptions*) {
    sync_system = create_sync_system()
    
    if options.path_settings.size() > 0 {
        load_user_settings(options.path_settings, sync_system)
    }
    
    // TODO: setup file monitor per SyncUnit
    // mon: FileMonitor
    // defer mon.cleanup()
    // yes := mon.check("test", callback, cast_unsafe<FileMonitorFlags>0, null)
    // if !yes
    //     log("monitor failed")
    // fn callback(change: FileMonitorChange*, user: void*) {
    //     log(&change.type, " ",change.path)
    //     // log(change.path)
    // }
 
    // TODO: Setup auto connections
 
    if options.use_gui {
        start_gui()
    } else if options.use_cli {
        start_cli(options)
    } else {
        log("GUI or CLI?")
    }
}



fn start_cli(options: AppOptions*) {
    // TODO: Circular buffer
    buffer_max := 1000
    buffer: char* = Allocate(buffer_max) // We don't but buffer on stack to avoid stack overflow problems, if we do write beyond the buffer then we will hopefully get a memory access violation.
    defer Free(buffer)
    
    cmd: StringBuilder
    defer cmd.cleanup()
    
    written_bytes := 0
    read_offset: i32
    
    cli_input_offset := 0
    came_from_cli_input := false
    
    log("Welcome to the REPL of UniSync. Type 'help' + enter for options.")
    while {
        has_newline := false
        for read_offset..written_bytes {
            chr := buffer[read_offset]
            read_offset++
            if chr == '\n' {
                has_newline = true
                break
            }
        }
        if !has_newline {
            bytes_read: i32
            if cli_input_offset < options.cli_input.size() {
                bytes_read = options.cli_input.size()
                if bytes_read > buffer_max - read_offset
                    bytes_read = buffer_max - read_offset
                memcpy(buffer + read_offset, options.cli_input.data() + cli_input_offset, bytes_read)
                cli_input_offset += bytes_read
                came_from_cli_input = true
                // TODO: When whole cli input has been read, we can free the string.
            } else {
                std_print(">")
                if written_bytes == 0 {
                   came_from_cli_input = false
                }
                if came_from_cli_input {
                    came_from_cli_input = false
                    std_print(buffer, read_offset)
                }
                #if OS_WINDOWS
                    handle := GetStdHandle(STD_INPUT_HANDLE)
                    yes := ReadFile(handle, buffer + read_offset, buffer_max - read_offset, &bytes_read, null)
                    if !yes {
                        err := GetLastError()
                        log("stdin read failed ",err)
                        break
                    }
                #else
                    // read(STDIN_FILENO, )
                #endif
            }
            written_bytes += bytes_read
            continue
        }
        
        if came_from_cli_input {
            std_print(">")
            std_print(buffer, read_offset)
        }
        
        cmd.clear()
        if buffer[read_offset-2] == '\r'
            cmd.append(buffer, read_offset-2) // -1 to skip carriage return and newline
        else
            cmd.append(buffer, read_offset-1) // -1 to skip newline
        memcpy(buffer, buffer + read_offset, written_bytes - read_offset)
        written_bytes -= read_offset
        read_offset = 0
        
        if cmd.size() == 0
            continue
        
        // Process command
        
        args := split(" ", cmd)
        defer args.cleanup()
        
        base_cmd := args[0]
        
        error := SYNCERR_NONE
        
        if cmd[0] == '#' {
            // comment
        } else if base_cmd == "help" {
            log("Help:")
            log(" exit/quit/q - End program")
            log(" tutorial - Prints more helpful information")
            log(" ls - List connection and units")
            log(" lsfiles <name> [options...] - List files of a unit")
            log(" addcon [name] - Adds a connection with an optional name")
            log(" addunit [name] - Adds a unit")
            log(" renamecon <current_name> <new_name> - Renames a connection")
            log(" renameunit <current_name> <new_name> - Renames a unit")
            log(" setroot <name> <path> - Sets the root of a unit")
            log(" setip <name> <ip> - Sets ip of a connection")
            log(" setport <name> <port> - Sets port of a connection")
            log(" settype <name> <server/client> - Specifies a connection as a server or client")
            log(" startcon <name> - Starts a connection")
            log(" stopcon <name> - Stops a connection")
        } else if base_cmd == "exit" || base_cmd == "quit" || base_cmd == "q" {
            break
        } else if base_cmd == "ls" {
            std_print("Connections:")
            if sync_system.connections.size() == 0
                log(" None")
            else
                log()
            for sync_system.connections.sliced() {
                log(" ",it.name)
                log("  ip: ",it.ip)
                log("  port: ",it.port)
                if it.flags & SYNCCON_IS_SERVER {
                    log("  type: server")
                    log("  active: ", it.server.is_active())
                    if it.server.is_active() {
                        log("  clients: ", it.server.get_number_connections())
                    }
                } else {
                    log("  type: client")
                    log("  active: ", it.client.is_active())
                }
            }
            std_print("Units:")
            if sync_system.units.size() == 0
                log(" None")
            else
                log()
            for sync_system.units.sliced() {
                log(" ",it.name)
                log("  root: ",it.root)
            }
        } else if base_cmd == "lsfiles" {
            if args.size() < 2 {
                log("One arguments are required")
            } else {
                name := args[1]
                
                unit := sync_system.find_unit(name)
                if !unit {
                    log("'",name,"' is not a unit.")
                } else {
                    std_prints("Files in unit '",name,"':")
                    if unit.files.getCount() == 0
                        log(" None")
                    else
                        log()
                    iter := unit.files.create_iterator()
                    while unit.files.iterate(&iter) {
                        it := iter.ptr
                        log(" ",it.path)
                        log("  time: ",it.timestamp)
                        log("  flags: ",&it.flags)
                    }
                }
            }
        } else if base_cmd == "addunit" {
            unit_name := "Unnamed"
            if args.size() > 1
                unit_name = args[1]
            error = sync_system.add_unit(unit_name)
            switch error {
                case SYNCERR_OCCUPIED_NAME:
                    log("Another unit is named '", unit_name, "', use a different name!")
                case SYNCERR_NONE: ;
                case:
            }
        } else if base_cmd == "addcon" {
            con_name := "Unnamed"
            if args.size() > 1
                con_name = args[1]
            error = sync_system.add_connection(con_name, "127.0.0.1", DEFAULT_PORT)
            switch error {
                case SYNCERR_OCCUPIED_NAME:
                    log("Another connection is named '", con_name, "', use a different name!")
                case SYNCERR_NONE: ;
                case:
            }
        } else if base_cmd == "renameunit" {
            if args.size() < 3 {
                log("Two arguments are required")
            } else {
                old_name := args[1]
                new_name := args[2]
                error = sync_system.rename_connection(old_name, new_name)
                switch error {
                    case SYNCERR_OCCUPIED_NAME:
                        log("Another unit is named '", new_name, "'', use a different name!")
                    case SYNCERR_NAME_NOT_FOUND:
                        log("Unit '", old_name, "' does not exist!")
                    case SYNCERR_NONE: ;
                    case:
                }
            }
        } else if base_cmd == "renamecon" {
            if args.size() < 3 {
                log("Two arguments are required")
            } else {
                old_name := args[1]
                new_name := args[2]
                error = sync_system.rename_connection(old_name, new_name)
                switch error {
                    case SYNCERR_OCCUPIED_NAME:
                        log("Another connection is named '", new_name, "'', use a different name!")
                    case SYNCERR_NAME_NOT_FOUND:
                        log("Connection '", old_name, "' does not exist!")
                    case SYNCERR_NONE: ;
                    case:
                }
            }
        } else if base_cmd == "setroot" {
            if args.size() < 3 {
                log("Two arguments is required")   
            } else {
                name := args[1]
                root := args[2]
                error = sync_system.set_root(name, root)
                switch error {
                    case SYNCERR_NAME_NOT_FOUND:
                        log("Unit '", name, "' does not exist!")
                    case SYNCERR_PATH_NOT_FOUND:
                        log("Path '", root, "' does not exist!")
                    case:
                }
            }
        } else if base_cmd == "setip" {
            if args.size() < 3 {
                log("Two arguments are required")
            } else {
                name := args[1]
                ip := args[2]
                error = sync_system.set_ip(name, ip)
                switch error {
                    case SYNCERR_NAME_NOT_FOUND:
                        log("Connection '", name, "' does not exist!")
                    case:
                }
            }
        } else if base_cmd == "settype" {
            if args.size() < 3 {
                log("Two arguments are required")
            } else {
                name := args[1]
                type := args[2]
                if type == "server" {
                    error = sync_system.set_connection_type(name, true)
                } else if type == "client" {
                    error = sync_system.set_connection_type(name, false)
                } else {
                    log("Type is limited to server and client, not '",type,"'")
                }
                switch error {
                    case SYNCERR_NAME_NOT_FOUND:
                        log("Connection '", name, "' does not exist!")
                    case:
                }
            }
        } else if base_cmd == "startcon" {
            if args.size() < 2 {
                log("One argument are required")
            } else {
                name := args[1]
                error = sync_system.start_connection(name)
                switch error {
                    case SYNCERR_NAME_NOT_FOUND:
                        log("Connection '", name, "' does not exist!")
                    case SYNCERR_CONNECTION_FAILED:
                        con := sync_system.find_connection(name)
                        log("Connection '", con.ip, "' failed! (con: ",name,")")
                    case:
                }
            }
        } else if base_cmd == "stopcon" {
            if args.size() < 2 {
                log("One argument are required")
            } else {
                name := args[1]
                error = sync_system.stop_connection(name)
                switch error {
                    case SYNCERR_NAME_NOT_FOUND:
                        log("Connection '", name, "' does not exist!")
                    case:
                }
            }
        } else if base_cmd == "tutorial" {
            log("UniSync allows you to synchronize files between computers.")
            log("A basic example requires UniSync on two computers and")
            log("a series of commands to set it up. You can find more")
            log("information here: https://github.com/Emarioo/UniSync")
            log("")
            log("Here is a quick guide:")
            log("- Start UniSync on two computers (refered to as C and S).")
            log("- On both computers, create a unit and a connection.")
            log("  Type 'help' to see the respective commands.")
            log("- On S, set the connection type to be a server.")
            log("  Then set type as client on C.")
            log("- On C, set the ip to the ip-address of computer S.")
            log("- Create one folder on each computer, this is the folder")
            log("  with files which will be synchronized. You should do")
            log("  this with a new folder to make sure things are working")
            log("  as expected.")
            log("- On both computers use 'setroot' and specify the path")
            log("  to the folders")
            log("- To begin synchronizing, start the server first and")
            log("  then the client.")
            log("")
            log("If you have problems contact 'emarioo' on discord.")
        } else {
            log("Command '",base_cmd,"' was not recognized. See 'help'.")
        }
        
        if error != SYNCERR_NONE {
            // something went wrong which means that remaining input
            // may do unexpected things
            written_bytes = 0
            came_from_cli_input = false
        }
    }
}
fn start_gui() {
    log("Starting gui")
    // GLFW init and stuff   
}
